# Used by docker-compose.yml to run the whole platform (all 5 services + 7 workers +
# Postgres + Redis) as one stack. Copy to .env and fill in before `docker compose up`.
#
# Per-service dev without Docker still works with no setup (apps/api/.env.example covers
# that path) — this file is specifically for the containerized/production-shaped stack.

# --- Postgres (container-internal only; change if exposing the DB beyond this stack) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=adgo

# --- Required secrets — docker compose refuses to start without these set (no fallback) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Shared secret the api gateway attaches to requests it proxies to scraper-service, so it
# can reject traffic that didn't come through the gateway.
INTERNAL_SERVICE_KEY=
# 32-byte hex key used to encrypt OAuth tokens at rest.
TOKEN_ENCRYPTION_KEY=

# --- Optional integrations (each degrades to a clearly-labeled mock/fallback if unset) ---
# Error tracking — falls back to console-only logging if unset.
SENTRY_DSN=
# Google Gemini — the SINGLE LLM backend the whole pipeline depends on (chat + structured
# tool-use + embeddings for Research Memory/RAG). An AI Studio API key; nothing in the pipeline
# works without it. Some pinned model versions report a quota limit of 0 on AI Studio keys while
# the `-latest` aliases carry real quota, so the default is an alias.
# Changing GEMINI_EMBEDDING_MODEL requires re-embedding stored vectors:
#   npx tsx apps/api/src/scripts/reembedResearchMemory.ts --yes
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1024
# Gemini quotas are PER-MINUTE and research fans out ~45 calls at once — this cap plus the
# client's 429-backoff is what stops a burst from failing whole research legs.
GEMINI_MAX_CONCURRENCY=4
# Thinking-token allowance added ON TOP of each caller's maxTokens. Thought tokens come out of the
# same maxOutputTokens budget as the answer, so without this a tight maxTokens is spent entirely on
# thinking and the call returns no output at all — an empty success the pipeline reads as "produced
# nothing". Cannot be disabled (thinkingBudget:0 is rejected with HTTP 400); 0 here means "send no cap".
GEMINI_THINKING_BUDGET=1024
RUNWAY_API_KEY=
# Ad-creative image generation — OPT-IN. Off by default: generation uses an instant in-process
# mock with NO network call. Enable the real multi-provider chain by setting
# IMAGE_GENERATION_ENABLED=true, OR by setting a DEDICATED image key (OPENAI_API_KEY or
# STABILITY_API_KEY — a dedicated key signals you want real images). When enabled: a prioritized
# fallback chain (Google Imagen -> OpenAI gpt-image-1 -> Stability, each tier used only when its
# key is set) -> keyless Pollinations (a live image.pollinations.ai call) -> an always-succeeds
# placeholder, so a creative image is never blank.
# Creatives currently come from MANUAL UPLOAD (Campaign Builder -> attach image/video), which is
# why this stays off. The provider chain below is kept wired so adopting a generation model later
# is a config change, not a code change.
# NOTE: GEMINI_API_KEY (set above, for the LLM) doubles as the Google Imagen key, so it is
# deliberately NOT an enable-trigger — otherwise every deployment would switch image generation on
# the moment the LLM was configured. Imagen stays usable as a provider once generation is enabled
# by the flag or by a DEDICATED key. Model overrides: IMAGEN_MODEL, OPENAI_IMAGE_MODEL.
IMAGE_GENERATION_ENABLED=
OPENAI_API_KEY=
STABILITY_API_KEY=
SCRAPEGRAPH_SERVICE_URL=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_ACCESS_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
CRM_INTERNAL_SERVICE_KEY=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
WOOCOMMERCE_STORE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
# Campaign-generation research cache: a completed research run for the same
# (workspace, business, url) is reused for this long before fresh research runs, so a
# repeat "generate" for the same business doesn't re-pay the 27 providers / ~50 searches /
# ~47 LLM calls. Default 604800000 (7 days). Keep <= the 14-day UI staleness horizon.
# Bypass per-request with { "forceRefresh": true } in the POST /campaigns/generate body.
CAMPAIGN_RESEARCH_CACHE_TTL_MS=604800000
# Cache quality-gate: a cached research run is reused only if its grounding confidence
# (context.metadata.overallConfidence, 0-1) is >= this AND its company-identity anchor is present.
# A degraded run (providers timed out → company=null, confabulated market) is re-researched
# instead of re-served. Default 0.50; out-of-[0,1]/non-finite falls back to 0.50.
CAMPAIGN_RESEARCH_MIN_CONFIDENCE=0.5
META_AD_LIBRARY_ACCESS_TOKEN=

# Search — SearXNG is the only backend (apps/api/src/infra/searchRouter.ts); Tavily/Serper
# were removed. Self-hosted (docker-compose.yml's `searxng` service), no per-call quota.
SEARXNG_BASE_URL=
# Crawl / content extraction — self-hosted crawl4ai (docker-compose.yml's `crawl4ai` service),
# runs concurrently with the in-house scraper and merges (infra/scrapeFallback.ts). Replaced
# Firecrawl. No per-call quota. CRAWL4AI_API_TOKEN optional (only if crawl4ai requires auth).
CRAWL4AI_BASE_URL=
CRAWL4AI_API_TOKEN=

# --- Public origin (used to build OAuth redirect URIs) ---
PUBLIC_ORIGIN=http://localhost:8080
